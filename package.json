		"@types/jest": "^30.0.0",
		"@types/node": "^25.2.2",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.2.0",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.6",
		"ts-node": "^10.9.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
