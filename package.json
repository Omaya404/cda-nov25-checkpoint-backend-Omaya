{
	"name": "cda-nov25-checkpoint-backend-omaya",
	"version": "1.0.0",
	"description": "Le but de cet exercice est de créer une API GraphQL avec Apollo Server, TypeGraphQL et TypeORM pour enregistrer et lire des pays avec leur code, leur nom et leur emoji.",
	"main": "index.js",
	"scripts": {
		"test": "jest --runInBand",
		"dev": "ts-node-dev --respawn --transpile-only src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"check": "biome check .",
		"format": "biome format --write ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Omaya404/cda-nov25-checkpoint-backend-Omaya.git"
	},
