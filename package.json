	},
	"homepage": "https://github.com/Omaya404/cda-nov25-checkpoint-backend-Omaya#readme",
	"dependencies": {
		"@apollo/server": "^5.4.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"dotenv": "^17.3.1",
		"graphql": "^16.12.0",
		"graphql-scalars": "^1.25.0",
		"reflect-metadata": "^0.2.2",
		"sqlite3": "^5.1.7",
